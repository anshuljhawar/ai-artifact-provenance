{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anshuljhawar/ai-artifact-provenance/schema/ai-artifact-provenance.schema.json",
  "title": "ai-artifact-provenance block v0.1",
  "type": "object",
  "required": ["ai_artifact_provenance", "ask", "status", "owner", "generator", "updated", "assumptions", "unknowns", "changelog"],
  "properties": {
    "ai_artifact_provenance": { "type": "string", "const": "0.1" },
    "title": { "type": "string" },
    "ask": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "audience": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "proposal", "decided", "superseded"] },
    "owner": { "type": "string", "minLength": 1 },
    "generator": {
      "type": "object",
      "required": ["tool"],
      "properties": { "tool": { "type": "string", "minLength": 1 }, "model": { "type": "string" } }
    },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "inputs": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "as_of": { "type": "string" }, "note": { "type": "string" } } } ] } },
    "constraints": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["quote"], "properties": { "quote": { "type": "string" }, "source": { "type": "string" } } } ] } },
    "assumptions": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "confirmed": { "type": "boolean" } } } ] } },
    "decisions": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["decision"], "properties": { "id": { "type": "string" }, "decision": { "type": "string" }, "why": { "type": "string" }, "quote": { "type": "string" }, "rejected": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["option"], "properties": { "option": { "type": "string" }, "why": { "type": "string" } } } ] } }, "superseded_by": { "type": ["string", "null"] } } } ] } },
    "unknowns": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" }, "how_to_check": { "type": "string" } } } ] } },
    "changelog": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["version", "date", "trigger"], "properties": { "version": { "type": "integer", "minimum": 1 }, "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }, "trigger": { "type": "string" }, "changed": { "type": "string" } } }
    },
    "links": { "type": "object", "additionalProperties": { "type": "string" } },
    "how_to_question": { "type": "string" }
  }
}
